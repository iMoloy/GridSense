# Application
PORT=5000
NODE_ENV=development

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT Auth
JWT_SECRET="gridsense-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="gridsense-refresh-secret-jwt-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Client CORS
CLIENT_URL="http://localhost:3000"

# Energy & Climate Constants
DEFAULT_RATE_PER_KWH=8.5
CARBON_FACTOR_KG=0.65
